# =============================================================
# Au2CAD — Agentic AI Reverse Engineering & Mold Design System
# =============================================================

# ── LLM Provider ──────────────────────────────────────────────
# Uncomment the line matching your LLM provider and fill in the key.
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=google
# LLM_PROVIDER=azure_openai

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://...

# LLM model name to use (e.g. gpt-4o, claude-3-5-sonnet, gemini-2.0-flash)
# LLM_MODEL=gpt-4o

# ── Hunyuan3D ─────────────────────────────────────────────────
# Set HUNYUAN3D_MODE to "api" or "local"
HUNYUAN3D_MODE=api
# HUNYUAN3D_API_URL=https://...
# HUNYUAN3D_API_KEY=...
# HUNYUAN3D_LOCAL_PATH=./third_party/Hunyuan3D

# ── CADFit ────────────────────────────────────────────────────
# Path to the CADFit executable / repo root
CADFIT_PATH=./third_party/CADFit
# Max iterations for CADFit reconstruction
CADFIT_MAX_ITERATIONS=10

# ── Geometry / Validation ─────────────────────────────────────
# IoU threshold to consider a CAD model validated
VALIDATION_IOU_THRESHOLD=0.90
# Max allowable dimension error in mm
VALIDATION_DIM_ERROR_MM=0.5

# ── Paths ─────────────────────────────────────────────────────
DEMO_PART_DIR=./demo_part
GROUND_TRUTH_DIR=./ground_truth
OUTPUT_DIR=./output
